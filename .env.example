DATABASE_URL="postgres://pme:pme@localhost:54329/personal_memory_engine"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
PME_DATA_DIR="./data"
PME_DATABASE_PATH="./data/quipu.sqlite"

# OpenAI-compatible chat-completions provider for AI processing.
# Any one provider key is enough for the prototype.
PME_LLM_API_KEY=""
PME_LLM_BASE_URL="https://api.openai.com/v1"
PME_LLM_MODEL="gpt-4o-mini"
OPENAI_API_KEY=""
OPENROUTER_API_KEY=""
GROQ_API_KEY=""
CEREBRAS_API_KEY=""

# Agent tools (optional)
# Set to false to disable headless browsing; fetch fallback still runs when Playwright fails.
PME_BROWSER_ENABLED="true"
# Local FFmpeg for uploaded video/screen-recording inspection (probe, frames, audio).
PME_FFMPEG_ENABLED="true"
# PME_FFMPEG_PATH="ffmpeg"
# PME_FFPROBE_PATH="ffprobe"
